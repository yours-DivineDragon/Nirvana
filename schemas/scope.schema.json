{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/scope.schema.json",
  "title": "Nirvana repository scope manifest",
  "type": "object",
  "required": ["schema_version", "created_at", "target_root", "repository_commit", "repository_dirty", "target_snapshot_sha256", "snapshot_complete", "max_analysis_file_bytes", "files", "excluded_directories", "toolchains", "frameworks", "languages", "untrusted_instruction_surfaces", "build_status", "test_status", "evidence_ceiling", "warnings"],
  "properties": {
    "schema_version": {"enum": ["1.2.0", "2.0.0"]},
    "created_at": {"type": "string"},
    "target_root": {"type": "string", "minLength": 1},
    "repository_commit": {"type": ["string", "null"]},
    "repository_dirty": {"type": ["boolean", "null"]},
    "target_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_complete": {"type": "boolean"},
    "max_analysis_file_bytes": {"type": "integer", "minimum": 1},
    "files": {"type": "array", "items": {"type": "object"}},
    "excluded_directories": {"type": "array", "items": {"type": "string"}},
    "toolchains": {"type": "array", "items": {"type": "string"}},
    "frameworks": {"type": "array", "items": {"type": "string"}},
    "languages": {"type": "object"},
    "untrusted_instruction_surfaces": {"type": "array", "items": {"type": "string"}},
    "build_status": {"enum": ["not_run", "not_detected", "planned", "passed", "failed"]},
    "test_status": {"enum": ["not_run", "not_detected", "planned", "passed", "failed"]},
    "evidence_ceiling": {"$ref": "common.schema.json#/$defs/evidenceLevel"},
    "dependency_manifests": {"type": "array", "items": {"type": "object"}},
    "discovered_artifacts": {"type": "array", "items": {"type": "object"}},
    "privileged_identities": {"type": "array", "items": {"type": "object"}},
    "upgrade_mechanisms": {"type": "array", "items": {"type": "object"}},
    "external_dependencies": {"type": "array", "items": {"type": "object"}},
    "build_plan": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "test_plan": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "deployment_matches": {"type": "array", "items": {"type": "object"}},
    "declared_tool_versions": {"type": "object"},
    "submodules": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
