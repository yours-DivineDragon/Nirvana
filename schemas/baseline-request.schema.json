{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/baseline-request.schema.json",
  "title": "Nirvana sandboxed baseline request",
  "type": "object",
  "required": ["schema_version", "steps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["step_id", "kind", "command", "cwd", "expected_return_code"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^B-[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["build", "test"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "expected_return_code": {"const": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
