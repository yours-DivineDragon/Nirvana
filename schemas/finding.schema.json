{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/finding.schema.json",
  "title": "Nirvana confirmed finding",
  "type": "object",
  "required": [
    "finding_id",
    "hypothesis_id",
    "title",
    "severity",
    "evidence_level",
    "security_property",
    "root_cause",
    "locations",
    "attacker_prerequisites",
    "assumptions",
    "causal_path",
    "reproducer",
    "impact",
    "severity_rationale",
    "reproduction_instructions",
    "remediation",
    "regression_test",
    "supporting_evidence"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^F-[A-Za-z0-9._-]+$"},
    "hypothesis_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "evidence_level": {"$ref": "common.schema.json#/$defs/evidenceLevel"},
    "security_property": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "locations": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/codeLocation"}},
    "attacker_prerequisites": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "causal_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reproducer": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "severity_rationale": {"type": "string", "minLength": 1},
    "reproduction_instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "remediation": {"type": "string", "minLength": 1},
    "regression_test": {"type": "string", "minLength": 1},
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]+$"}
    },
    "reproducer_evidence_id": {"type": ["string", "null"], "pattern": "^E-[A-Za-z0-9._-]+$"},
    "regression_evidence_id": {"type": ["string", "null"], "pattern": "^E-[A-Za-z0-9._-]+$"},
    "novelty": {
      "enum": ["exact_duplicate", "known_unfixed_issue", "variant", "new_instance", "novel_mechanism", "uncertain_novelty"]
    },
    "related_issues": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
