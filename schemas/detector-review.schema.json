{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/detector-review.schema.json",
  "title": "Nirvana detector promotion review",
  "type": "object",
  "required": ["finding_id", "positive_regression", "negative_benign_cases", "cross_project_generalisation", "performance_noise_budget", "human_review", "provenance_licence", "evidence_artifacts", "reviewer", "notes"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^F-[A-Za-z0-9._-]+$"},
    "positive_regression": {"type": "boolean"},
    "negative_benign_cases": {"type": "boolean"},
    "cross_project_generalisation": {"type": "boolean"},
    "performance_noise_budget": {"type": "boolean"},
    "human_review": {"type": "boolean"},
    "provenance_licence": {"type": "boolean"},
    "evidence_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reviewer": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
