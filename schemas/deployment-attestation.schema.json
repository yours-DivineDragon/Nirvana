{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/deployment-attestation.schema.json",
  "title": "Nirvana local deployed-bytecode attestation request",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["deployment_id", "source", "compiler_config_sha256", "built_bytecode_path", "deployed_bytecode_path", "network", "address", "capture_provenance"],
        "properties": {
          "deployment_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "compiler_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "built_bytecode_path": {"type": "string", "minLength": 1},
          "deployed_bytecode_path": {"type": "string", "minLength": 1},
          "network": {"type": "string", "minLength": 1},
          "address": {"type": "string", "minLength": 1},
          "capture_provenance": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
