{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/benchmark-manifest.schema.json",
  "title": "Nirvana contamination-controlled benchmark manifest",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "cutoff", "track", "blind", "corpora", "cases", "trials"],
  "properties": {
    "schema_version": {"const": "1.5.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "cutoff": {"type": "string", "minLength": 1},
    "track": {"enum": ["historical_web3", "web3_exploit", "web3_hidden_variants", "solana_move", "native_jvm", "fuzzing", "continuous_discovery", "patch_quality", "novel_discovery"]},
    "blind": {"type": "boolean"},
    "case_pack": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "corpora": {"type": "array", "items": {"type": "object"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["started_at", "ended_at", "worker_count", "compute_hours", "ledger_checkpoint", "coverage_sha256"],
        "properties": {
          "started_at": {"type": "string", "minLength": 1},
          "ended_at": {"type": "string", "minLength": 1},
          "worker_count": {"type": "integer", "minimum": 1},
          "compute_hours": {"type": "number", "exclusiveMinimum": 0},
          "coverage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "ledger_checkpoint": {
            "type": "object",
            "required": ["algorithm", "run_directory", "checkpoint_path", "checkpoint_sha256"],
            "properties": {
              "algorithm": {"const": "nirvana-ledger-checkpoint-v1"},
              "run_directory": {"type": "string", "minLength": 1},
              "checkpoint_path": {"type": "string", "minLength": 1},
              "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "release_evidence": {"type": "object"}
  },
  "additionalProperties": false
}
