{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/execution-request.schema.json",
  "title": "Nirvana executable evidence request",
  "type": "object",
  "required": [
    "evidence_id",
    "hypothesis_id",
    "evidence_level",
    "kind",
    "summary",
    "adapter",
    "claim",
    "assertions",
    "tool_version",
    "command"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]+$"},
    "hypothesis_id": {"type": "string", "pattern": "^H-[A-Za-z0-9._-]+$"},
    "evidence_level": {"enum": ["structurally_confirmed", "executable"]},
    "kind": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "adapter": {
      "enum": ["forge-test", "echidna", "medusa", "halmos", "cargo-test", "pytest", "node-test", "solc-ast", "slither", "semgrep"]
    },
    "claim": {
      "type": "object",
      "required": ["security_property", "suspected_violation"],
      "properties": {
        "security_property": {"type": "string", "minLength": 1},
        "suspected_violation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assertion_id", "source", "operator", "value"],
        "properties": {
          "assertion_id": {"type": "string", "pattern": "^A-[A-Za-z0-9._-]+$"},
          "source": {"enum": ["stdout", "stderr"]},
          "operator": {"enum": ["contains", "regex", "json_pointer_equals"]},
          "value": {},
          "pointer": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cwd": {"type": "string", "minLength": 1},
    "stdin": {"type": "string"},
    "expected_return_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "integer"}
    },
    "replay_mode": {"enum": ["assertions", "strict"]},
    "tool_version": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
