{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/execution-request.schema.json",
  "title": "Nirvana executable evidence request",
  "type": "object",
  "required": [
    "evidence_id",
    "hypothesis_id",
    "kind",
    "summary",
    "command"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]+$"},
    "hypothesis_id": {"type": "string", "pattern": "^H-[A-Za-z0-9._-]+$"},
    "kind": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cwd": {"type": "string", "minLength": 1},
    "stdin": {"type": "string"},
    "expected_return_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    },
    "tool_version": {"type": ["string", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
