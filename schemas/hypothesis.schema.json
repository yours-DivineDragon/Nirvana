{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/hypothesis.schema.json",
  "title": "Nirvana security hypothesis",
  "type": "object",
  "required": [
    "hypothesis_id",
    "security_property",
    "suspected_violation",
    "affected_assets",
    "required_attacker_capabilities",
    "assumptions",
    "candidate_locations",
    "verification_plan",
    "threat_lens",
    "generator"
  ],
  "properties": {
    "hypothesis_id": {"type": "string", "pattern": "^H-[A-Za-z0-9._-]+$"},
    "security_property": {"type": "string", "minLength": 1},
    "suspected_violation": {"type": "string", "minLength": 1},
    "affected_assets": {"type": "array", "items": {"type": "string"}},
    "required_attacker_capabilities": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "candidate_locations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/codeLocation"}
    },
    "verification_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "threat_lens": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "graph_slice": {"type": "array", "items": {"type": "string"}},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}},
    "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
    "unresolved_assumptions": {"type": "array", "items": {"type": "string"}},
    "coverage_achieved": {"type": "array", "items": {"type": "string"}},
    "proposed_next_experiment": {"type": ["string", "null"]},
    "cost": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "evidence_level": {"$ref": "common.schema.json#/$defs/evidenceLevel"},
    "status": {
      "enum": ["proposed", "localising", "awaiting_verification", "verified", "rejected", "rescued"]
    },
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
