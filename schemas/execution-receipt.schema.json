{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/execution-receipt.schema.json",
  "title": "Nirvana executable evidence receipt",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "evidence_id",
    "target",
    "runner",
    "harness",
    "negative_control",
    "request",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "1.4.0"},
    "created_at": {"type": "string"},
    "evidence_id": {"type": "string", "pattern": "^E-[A-Za-z0-9._-]+$"},
    "replay_of": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {"$ref": "#/$defs/target"},
    "runner": {
      "type": "object",
      "required": ["mode", "policy_sha256", "docker_image", "adapter_contract"],
      "properties": {
        "mode": {"enum": ["deny", "host", "docker"]},
        "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "docker_image": {"type": ["string", "null"]},
        "adapter_contract": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[0-9]+$"}
      },
      "additionalProperties": false
    },
    "harness": {
      "type": ["object", "null"],
      "required": ["root", "snapshot_sha256", "file_count", "total_bytes"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "negative_control": {
      "type": ["object", "null"],
      "required": ["target", "changed_files", "expected_return_codes", "result"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["path", "target_sha256", "control_sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "target_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "control_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "expected_return_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "result": {"$ref": "#/$defs/result"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "evidence_id",
        "hypothesis_id",
        "evidence_level",
        "kind",
        "summary",
        "adapter",
        "claim",
        "assertions",
        "control_invariants",
        "command",
        "cwd",
        "expected_return_codes",
        "replay_mode",
        "tool_version",
        "assumptions",
        "harness",
        "negative_control",
        "stdin_base64",
        "stdin_sha256"
      ],
      "properties": {
        "evidence_id": {"type": "string"},
        "hypothesis_id": {"type": "string"},
        "evidence_level": {"enum": ["structurally_confirmed", "executable"]},
        "kind": {"type": "string"},
        "summary": {"type": "string"},
        "adapter": {"type": "string"},
        "claim": {"type": "object"},
        "assertions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object"}},
        "control_invariants": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
        "command": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "expected_return_codes": {"type": "array", "items": {"type": "integer"}},
        "replay_mode": {"enum": ["assertions", "strict"]},
        "tool_version": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "harness": {"type": ["object", "null"]},
        "negative_control": {"type": ["object", "null"]},
        "stdin_base64": {"type": "string"},
        "stdin_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["root", "snapshot_sha256"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "assertionResult": {
      "type": "object",
      "required": ["assertion_id", "passed", "observed_sha256", "error"],
      "properties": {
        "assertion_id": {"type": "string"},
        "passed": {"type": "boolean"},
        "observed_sha256": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "command",
        "adapter_outcome",
        "return_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_base64",
        "stderr_base64",
        "duration_ms",
        "blocked_reason",
        "timed_out",
        "assertions",
        "control_invariants"
      ],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "adapter_outcome": {"enum": ["success", "test_failure", "invalid"]},
        "return_code": {"type": ["integer", "null"]},
        "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stdout_base64": {"type": "string"},
        "stderr_base64": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "blocked_reason": {"type": ["string", "null"]},
        "timed_out": {"type": "boolean"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/assertionResult"}
        },
        "control_invariants": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/assertionResult"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
