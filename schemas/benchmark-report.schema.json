{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/benchmark-report.schema.json",
  "title": "Nirvana benchmark evaluation report",
  "type": "object",
  "required": ["schema_version", "created_at", "benchmark_id", "manifest_sha256", "track", "valid", "temporal_validation", "ground_truth_validation", "finding_attribution_validation", "ledger_validation", "magma_validation", "invalid_reasons", "counts", "metrics", "magma", "suite_qualification", "release_gates", "warnings"],
  "properties": {
    "schema_version": {"const": "1.10.0"},
    "created_at": {"type": "string"},
    "benchmark_id": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "track": {"type": "string"},
    "valid": {"type": "boolean"},
    "temporal_validation": {"type": "object"},
    "ground_truth_validation": {"type": "object"},
    "finding_attribution_validation": {"type": "object"},
    "ledger_validation": {"type": "object"},
    "magma_validation": {"type": "object"},
    "invalid_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "counts": {"type": "object"},
    "metrics": {"type": ["object", "null"]},
    "magma": {"type": ["object", "null"]},
    "suite_qualification": {"type": "object"},
    "release_gates": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
