{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/differential-triage.schema.json",
  "title": "Nirvana differential mismatch triage",
  "type": "object",
  "required": ["schema_version", "created_at", "report_sha256", "case_id", "classification", "rationale", "reviewed_outcomes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_at": {"type": "string"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_id": {"type": "string", "minLength": 1},
    "classification": {"enum": ["harness_bug", "implementation_bug", "spec_ambiguity", "clear_but_unsafe_spec"]},
    "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewed_outcomes": {"type": "array", "minItems": 2, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
