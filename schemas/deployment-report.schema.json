{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/deployment-report.schema.json",
  "title": "Nirvana deployed-bytecode comparison report",
  "type": "object",
  "required": ["schema_version", "created_at", "attestation_sha256", "entries", "all_match", "network_access_performed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_at": {"type": "string"},
    "attestation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "all_match": {"type": "boolean"},
    "network_access_performed": {"const": false}
  },
  "additionalProperties": false
}
