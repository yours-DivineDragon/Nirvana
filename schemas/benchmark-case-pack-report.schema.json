{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana.security/schemas/benchmark-case-pack-report.schema.json",
  "title": "Nirvana benchmark case-pack verification report",
  "type": "object",
  "required": ["schema_version", "created_at", "pack_id", "case_pack_sha256", "cutoff", "valid", "independent", "target_snapshot_algorithm", "ground_truth_commitment_algorithm", "ground_truth_sealing", "author_attestation", "generator", "case_count", "case_ids", "cases"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "created_at": {"type": "string", "minLength": 1},
    "pack_id": {"type": "string", "minLength": 1},
    "case_pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cutoff": {"type": "string", "minLength": 1},
    "valid": {"const": true},
    "independent": {"const": true},
    "target_snapshot_algorithm": {"const": "nirvana-regular-file-tree-v1"},
    "ground_truth_commitment_algorithm": {"const": "sha256-canonical-ground-truth-v1"},
    "ground_truth_sealing": {"type": "object"},
    "author_attestation": {"type": "object"},
    "generator": {"type": "object"},
    "case_count": {"type": "integer", "minimum": 1},
    "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "originated_at", "disclosed_at", "hidden_variant", "transformation_log_sha256", "kloc", "target_snapshot_sha256", "public_commitment_sha256", "public_commitment_artifact_sha256", "sealed_ground_truth_sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "originated_at": {"type": "string", "minLength": 1},
          "disclosed_at": {"type": "string", "minLength": 1},
          "hidden_variant": {"type": "boolean"},
          "transformation_log_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "kloc": {"type": "number", "minimum": 0},
          "target_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "public_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "public_commitment_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sealed_ground_truth_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
